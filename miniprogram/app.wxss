/* 全局样式 */
page {
  background: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: #124E5B;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text {
  box-sizing: border-box;
}

/* ================= 通用页面骨架（带导航栏的页面共用） ================= */
/* 全出血：内容通铺到屏幕边缘；顶部安全区由 nav-bar 组件实测注入（见 app.ts onLaunch） */
.page {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 0 0 0;
}

.screen {
  background: #FFFFFF;
  padding: 12rpx 32rpx 200rpx;
}

/* ================= 通用右箭头 ================= */
.chev {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid #C2CFD2;
  border-right: 4rpx solid #C2CFD2;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.chev.up {
  transform: rotate(-135deg);
}

/* ================= 共享图标（内联 SVG，零依赖） ================= */
.ic {
  width: 54rpx;
  height: 54rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

