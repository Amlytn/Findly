/* 全局样式 */
page {
  background: #E3F4F5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  color: #124E5B;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

view, text {
  box-sizing: border-box;
}

/* ================= 通用页面骨架（带导航栏的页面共用） ================= */
.page {
  min-height: 100vh;
  background: #E3F4F5;
  padding: calc(env(safe-area-inset-top) + 28rpx) 24rpx 0;
}

.screen {
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  padding: 24rpx 32rpx 180rpx;
  min-height: calc(100vh - env(safe-area-inset-top) - 28rpx);
  box-shadow: 0 -10rpx 60rpx rgba(4, 134, 157, 0.10);
}

/* ================= 通用右箭头 ================= */
.chev {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid #C2CFD2;
  border-right: 4rpx solid #C2CFD2;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.chev.up {
  transform: rotate(-135deg);
}

/* ================= 共享图标（内联 SVG，零依赖） ================= */
.ic {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

