.s-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #F0F6F7;
  /* 与首页搜索栏一致：圆角比 ≈ 0.29 × 栏高 */
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin-top: 8rpx;
}

.s-bar .ic {
  width: 34rpx;
  height: 34rpx;
}

.s-ph-txt {
  margin-left: 14rpx;
  font-size: 27rpx;
  color: #9AB0B4;
}

.chips {
  white-space: nowrap;
  width: 100%;
  margin-top: 28rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #F0F6F7;
  color: #5E7A80;
  font-size: 26rpx;
  margin-right: 18rpx;
}

.chip.on {
  background: linear-gradient(135deg, #31CBBB, #04869D);
  color: #FFFFFF;
  font-weight: 700;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
}

.g-card {
  width: calc(50% - 12rpx);
  margin-bottom: 28rpx;
}

.g-card image {
  width: 100%;
  /* 1:1 容器：(686 - 24) / 2 = 331rpx */
  height: 331rpx;
  border-radius: 24rpx;
  background: #F5F7F8;
  display: block;
}

.g-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #124E5B;
}

.g-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9AB0B4;
}

.g-loc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #B5C4C7;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #9AB0B4;
}

/* 静默刷新的页面内反馈（下拉/返回触发时出现在分类 chips 与网格之间） */
.list-loading {
  margin: 16rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  color: #8FA8AD;
}

/* ============ scroll-view 自定义下拉刷新布局 ============ */
/* 导航固定顶部，列表区占满剩余高度（异形屏由 nav-bar 内部实测值适配） */
.items-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航区补全局边距（内容区由内层 .screen 自行取 32rpx）：左右与其他页对齐，顶部对齐 .screen 的 12rpx 顶距 */
.items-nav {
  padding: 12rpx 32rpx 0;
}

.items-scroll {
  flex: 1;
  min-height: 0;
}

/* 自定义刷新槽：位于导航栏下方（比原生圆点的屏幕最顶端更低），三点轮播仿原生加载动画 */
/* 高度由内联样式动态控制（跟随下拉距离）；width:100% 让槽位撑满屏宽——
   自定义刷新槽默认收缩到内容宽，不补宽度会导致三点贴在屏幕最左侧 */
.refresher-slot {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.refresher-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: #6A8C97;
  animation: refDot 1.2s ease-in-out infinite;
}

.refresher-dot-2 {
  animation-delay: 0.15s;
}

.refresher-dot-3 {
  animation-delay: 0.3s;
}

@keyframes refDot {
  0%, 60%, 100% {
    opacity: 0.2;
    transform: scale(0.75);
  }
  30% {
    opacity: 1;
    transform: scale(1);
  }
}
