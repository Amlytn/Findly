.s-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #F0F6F7;
  /* 与首页搜索栏一致：圆角比 ≈ 0.29 × 栏高 */
  border-radius: 24rpx;
  padding: 0 28rpx;
  margin-top: 8rpx;
}

.s-bar .ic {
  width: 34rpx;
  height: 34rpx;
}

.s-ph-txt {
  margin-left: 14rpx;
  font-size: 27rpx;
  color: #9AB0B4;
}

.chips {
  white-space: nowrap;
  width: 100%;
  margin-top: 28rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #F0F6F7;
  color: #5E7A80;
  font-size: 26rpx;
  margin-right: 18rpx;
}

.chip.on {
  background: linear-gradient(135deg, #31CBBB, #04869D);
  color: #FFFFFF;
  font-weight: 700;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
}

.g-card {
  width: calc(50% - 12rpx);
  margin-bottom: 28rpx;
}

.g-card image {
  width: 100%;
  /* 1:1 容器：(686 - 24) / 2 = 331rpx */
  height: 331rpx;
  border-radius: 24rpx;
  background: #F5F7F8;
  display: block;
}

.g-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #124E5B;
}

.g-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9AB0B4;
}

.g-loc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #B5C4C7;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #9AB0B4;
}
