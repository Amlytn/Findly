<view class="page">
  <view class="screen">
    <nav-bar title="搜索" />

    <view class="ai-label">AI 智能搜索</view>
    <view class="s-bar">
      <view class="ic ic-search"></view>
      <input
        class="s-input"
        placeholder="搜索你想找的物品、空间..."
        placeholder-class="s-ph"
        confirm-type="search"
        value="{{kw}}"
        bindinput="onInput"
        bindconfirm="go"
      />
    </view>

    <!-- 搜索历史：仅未输入状态展示（PRD 图 6） -->
    <view class="hist-head" wx:if="{{!kw && history.length > 0}}">
      <text class="hist-title">搜索历史</text>
      <text class="hist-clear" catchtap="clearHist">清空</text>
    </view>
    <view class="hist-chips" wx:if="{{!kw && history.length > 0}}">
      <view class="hist-chip" wx:for="{{history}}" wx:key="*this" bindtap="goHist" data-kw="{{item}}">{{item}}</view>
    </view>

    <view class="sec-title">相关物品</view>
    <view class="rel-card" wx:for="{{hot}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image src="{{item.img}}" mode="aspectFit" />
      <view class="rel-info">
        <view class="rel-name">{{item.name}}</view>
        <view class="rel-meta">{{item.meta ? item.meta + ' · ' : ''}}{{item.count}}件</view>
        <view class="rel-loc">{{item.space}} · {{item.zone}}</view>
      </view>
      <view class="chev"></view>
    </view>

    <view class="sec-title">你可能还想找</view>
    <view class="sug" wx:for="{{suggestions}}" wx:key="*this" bindtap="goSug" data-kw="{{item}}">
      <view class="ic ic-search"></view>
      <text class="sug-txt">{{item}}</text>
      <view class="chev"></view>
    </view>
  </view>
</view>
