<view class="page">
  <view class="screen">
    <nav-bar title="{{manual ? '添加物品' : '识别结果'}}" />

    <view class="r-top">
      <block wx:if="{{manual}}">
        <view class="r-img {{img ? '' : 'r-img-pick'}}" bindtap="pickFromAlbum">
          <image wx:if="{{img}}" class="r-img-pic" src="{{img}}" mode="aspectFit" />
          <view wx:else class="r-img-plus"></view>
        </view>
        <view class="r-acc">手动添加</view>
      </block>
      <block wx:else>
        <image class="r-img" src="{{img}}" mode="aspectFit" />
        <view class="r-acc" wx:if="{{recognizing}}">AI 识别中…</view>
        <view class="r-acc" wx:elif="{{aiFailed}}">识别不可用</view>
        <view class="r-acc" wx:else>识别准确 {{score}}%</view>
      </block>
    </view>

    <view class="r-note" wx:if="{{aiNote}}">{{aiNote}}</view>

    <view class="r-rows">
      <view class="r-row" bindtap="editName">
        <text class="k">名称</text>
        <text class="v">{{draft.name || '点击填写（必填）'}}</text>
      </view>
      <view class="r-row">
        <text class="k">品牌</text>
        <text class="v">{{draft.brand}}</text>
      </view>
      <view class="r-row">
        <text class="k">型号</text>
        <text class="v">{{draft.model}}</text>
      </view>
      <view class="r-row">
        <text class="k">类别</text>
        <text class="v">{{draft.category}}</text>
      </view>
      <view class="r-row">
        <text class="k">颜色</text>
        <text class="v">{{draft.color}}</text>
      </view>
      <view class="r-row desc">
        <text class="k">描述</text>
        <text class="v">{{draft.desc}}</text>
      </view>
      <view class="r-row tags-row">
        <text class="k">标签</text>
        <view class="tags">
          <view class="tag-chip" wx:for="{{draft.tags}}" wx:key="*this" bindtap="removeTag" data-t="{{item}}">
            {{item}}<text class="x">×</text>
          </view>
          <view class="tag-chip add" bindtap="addTag">＋ 标签</view>
        </view>
      </view>
    </view>

    <view class="r-loc">
      <view class="loc-head">
        <text class="loc-title">选择位置</text>
        <text class="loc-change" bindtap="changeLoc">更改位置</text>
      </view>
      <view class="crumb">
        <view class="ic ic-pin"></view>
        <text class="crumb-txt">{{locText}}</text>
      </view>
    </view>

    <view class="btn-primary r-save" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
  </view>
</view>
