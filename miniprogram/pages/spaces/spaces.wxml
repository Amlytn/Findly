<view class="page">
  <view class="screen">
    <nav-bar title="空间管理" />

    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <view class="empty" wx:elif="{{error}}" bindtap="retry">{{error}}，点击重试</view>

    <view class="sp-row" wx:for="{{spaces}}" wx:key="id" bindtap="goSpace" data-name="{{item.name}}">
      <view class="sp-chip chip-house">
        <view class="ic ic-house"></view>
      </view>
      <view class="sp-info">
        <view class="sp-name">{{item.name}}</view>
        <view class="sp-meta">{{item.zones}}个区域 · {{item.items}}件物品</view>
      </view>
      <view class="chev"></view>
    </view>

    <view class="btn-outline add-space" bindtap="addSpace">
      <view class="ic ic-plus"></view>
      <text>添加空间</text>
    </view>
  </view>
</view>
