<view class="page">
  <view class="screen">
    <nav-bar title="空间管理" />

    <!-- 顶部规划提示通栏（对齐设计稿） -->
    <view class="tip-bar" bindtap="onTipTap">
      <view class="tip-left">
        <image class="tip-icon" src="/assets/spaces/glyphs/home.svg" mode="aspectFit" />
        <text class="tip-text">合理规划空间，让物品各归其位</text>
      </view>
      <image class="tip-arrow" src="/assets/spaces/glyphs/chevron_right.svg" mode="aspectFit" />
    </view>

    <!-- 加载中 / 错误态 -->
    <view class="state-box" wx:if="{{loading}}">
      <view class="state-loading-spinner"></view>
      <text class="state-text">空间加载中…</text>
    </view>
    <view class="state-box" wx:elif="{{error}}" bindtap="retry">
      <view class="state-text state-err">{{error}}，点击重试</view>
    </view>

    <!-- 空白状态引导 -->
    <view class="empty-state" wx:elif="{{!sections.length}}">
      <view class="empty-icon-box">
        <image class="empty-icon" src="/assets/spaces/glyphs/home.svg" mode="aspectFit" />
      </view>
      <view class="empty-title">还没有创建任何空间</view>
      <view class="empty-desc">添加第一个空间（如：我的家、办公室），开始清晰收纳</view>
      <view class="empty-btn" bindtap="addRootSpace">＋ 创建我的家</view>
    </view>

    <!-- 空间分组列表 -->
    <block wx:else>
      <view class="spaces-scroll">
        <view class="section-group" wx:for="{{sections}}" wx:key="id" wx:for-item="sec">
          
          <!-- 根空间分组头部（Section Header） -->
          <view
            class="section-header"
            bindtap="tapSectionHeader"
            bindlongpress="onSectionLongPress"
            data-section="{{sec}}"
          >
            <view class="sec-left">
              <image class="sec-icon" src="{{sec.glyphIcon}}" mode="aspectFit" />
              <text class="sec-title">{{sec.name}}</text>
              <text class="sec-count">{{sec.total}}件</text>
            </view>
            <view class="sec-right">
              <view
                class="sec-act-btn"
                catchtap="onSectionAddChild"
                data-section="{{sec}}"
                aria-label="添加子空间"
              >
                <text class="sec-act-plus">＋</text>
              </view>
              <view
                class="sec-act-btn sec-act-settings"
                catchtap="onSectionSettings"
                data-section="{{sec}}"
                aria-label="空间设置"
              >
                <image class="sec-act-icon" src="/assets/spaces/glyphs/settings.svg" mode="aspectFit" />
              </view>
              <view
                class="sec-toggle {{sec.collapsed ? 'is-collapsed' : ''}}"
                catchtap="toggleSection"
                data-id="{{sec.id}}"
                wx:if="{{sec.children.length}}"
              >
                <image class="sec-arrow" src="/assets/spaces/glyphs/chevron_down.svg" mode="aspectFit" />
              </view>
            </view>
          </view>

          <!-- 若无子空间，展示清晰引导卡片，不伪装成子空间面板 -->
          <view class="sec-empty-wrap" wx:if="{{!sec.children.length}}" bindtap="onSectionAddChild" data-section="{{sec}}">
            <view class="sec-empty-card">
              <text class="sec-empty-tip">点击此处或右上角 ＋ 添加子空间（如：书房、卧室）</text>
            </view>
          </view>

          <!-- 根空间下的子空间卡片流（展开态） -->
          <view class="cards-container" wx:if="{{!sec.collapsed}}">
            <block wx:for="{{sec.children}}" wx:key="id" wx:for-item="card">
              
              <!-- 单张空间卡片（Squircle 图标 + 路径 + 独立展开指示箭头） -->
              <view
                class="sp-card {{expandedMap[card.id] ? 'is-expanded' : ''}}"
                bindtap="tapCard"
                bindlongpress="onCardLongPress"
                data-item="{{card}}"
              >
                <view class="card-left">
                  <image class="card-icon" src="{{card.cardIcon}}" mode="aspectFit" />
                  <view class="card-info">
                    <view class="card-title-row">
                      <text class="card-name">{{card.name}}</text>
                      <text class="card-count">{{card.total}}件</text>
                    </view>
                    <view class="card-path">{{card.pathText}}</view>
                  </view>
                </view>
                <view class="card-arrow-box {{expandedMap[card.id] ? 'arrow-down' : ''}}">
                  <image class="card-arrow" src="/assets/spaces/glyphs/chevron_right.svg" mode="aspectFit" />
                </view>
              </view>

              <!-- 新版分层解耦式内联抽屉面板（点击其他卡片不自动收起，仅主动点击再次折叠） -->
              <view class="in-panel" wx:if="{{expandedMap[card.id]}}">
                <!-- 第一层：专属空间管理工具栏（独立成行，等宽均分，绝不与标题竞争横向宽度） -->
                <view class="panel-act-row">
                  <view class="panel-act-btn" catchtap="onPanelRename" data-item="{{card}}">
                    <text>重命名</text>
                  </view>
                  <view class="panel-act-btn act-add" catchtap="onPanelAddItem" data-item="{{card}}">
                    <text>加入物品</text>
                  </view>
                  <view class="panel-act-btn act-del" catchtap="onPanelDelete" data-item="{{card}}">
                    <text>删除</text>
                  </view>
                </view>

                <!-- 第二层：物品统计信息行（纯粹独立，无按钮抢占） -->
                <view class="panel-head-row">
                  <view class="panel-head-title">存放在此的物品</view>
                  <view class="panel-head-badge">共 {{itemsCountMap[card.id] || 0}} 件</view>
                </view>

                <!-- 第三层：物品流 / 加载中 / 友好空态提示 -->
                <view class="panel-loading" wx:if="{{loadingMap[card.id]}}">
                  <view class="state-loading-spinner"></view>
                  <text class="panel-loading-text">正在读取物品列表…</text>
                </view>

                <view class="panel-empty" wx:elif="{{!itemsCountMap[card.id]}}">
                  <image class="panel-empty-icon" src="/assets/spaces/glyphs/other_space.svg" mode="aspectFit" />
                  <view class="panel-empty-title">{{card.total > 0 ? '物品存放在其下级子空间中' : '此空间暂无直接存放的物品'}}</view>
                  <view class="panel-empty-desc" wx:if="{{card.total > 0}}">可轻触其下级子空间卡片展开盘点</view>
                </view>

                <view class="panel-item-list" wx:else>
                  <view
                    class="p-item-card"
                    wx:for="{{itemsMap[card.id]}}"
                    wx:key="id"
                    bindtap="goItemDetail"
                    data-id="{{item.id}}"
                  >
                    <image class="p-item-img" src="{{item.img}}" mode="aspectFill" />
                    <view class="p-item-info">
                      <view class="p-item-name">{{item.name}}</view>
                      <view class="p-item-meta">{{item.subtitle}}</view>
                    </view>
                    <image class="p-item-arrow" src="/assets/spaces/glyphs/chevron_right.svg" mode="aspectFit" />
                  </view>
                </view>
              </view>

            </block>
          </view>
        </view>
      </view>

      <!-- 底部操作区（常驻单一「＋ 添加空间」） -->
      <view class="bottom-actions">
        <view class="btn-main" bindtap="onAddButtonTap">
          <text class="btn-plus">＋</text>
          <text>添加空间</text>
        </view>
        <view class="bottom-hint">提示：长按空间可 重命名 / 添加子空间 / 删除</view>
      </view>
    </block>

  </view>

  <!-- 自定义空间设置弹层（取代微信原生 ActionSheet） -->
  <view class="custom-modal-mask {{settingModalVisible ? 'is-visible' : ''}}" bindtap="closeSettingModal" catchtouchmove="preventTouchMove">
    <view class="custom-modal-sheet {{settingModalVisible ? 'is-visible' : ''}}" catchtap="preventBubble">
      
      <!-- 弹层顶部拖拽指示条 -->
      <view class="modal-handle-bar">
        <view class="modal-handle"></view>
      </view>

      <!-- 空间信息头 -->
      <view class="modal-space-info">
        <image class="modal-space-icon" src="{{settingTarget.glyphIcon || '/assets/spaces/glyphs/home.svg'}}" mode="aspectFit" />
        <view class="modal-space-meta">
          <view class="modal-space-name">{{settingTarget.name}}</view>
          <view class="modal-space-sub">空间管理设置 · 累计 {{settingTarget.total || 0}} 件物品</view>
        </view>
      </view>

      <!-- 操作项列表 -->
      <view class="modal-actions-list">
        <view class="modal-action-card" bindtap="onSettingModalRename">
          <view class="modal-act-left">
            <view class="modal-act-title">重命名空间</view>
            <view class="modal-act-desc">修改该空间的显示名称</view>
          </view>
          <image class="modal-act-arrow" src="/assets/spaces/glyphs/chevron_right.svg" mode="aspectFit" />
        </view>

        <view class="modal-action-card act-danger" bindtap="onSettingModalDelete">
          <view class="modal-act-left">
            <view class="modal-act-title title-danger">删除空间</view>
            <view class="modal-act-desc">删除该空间（若有子空间或物品需先清空）</view>
          </view>
          <image class="modal-act-arrow" src="/assets/spaces/glyphs/chevron_right.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 底部取消操作 -->
      <view class="modal-cancel-btn" bindtap="closeSettingModal">
        <text>取消</text>
      </view>
    </view>
  </view>
</view>
