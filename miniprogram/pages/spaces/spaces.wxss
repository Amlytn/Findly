/* 空间管理（第三批：全页就地展开；节点/货架/行样式在 space-node 组件内） */

/* 1. 沉底色全局覆盖：确保整个页面从状态栏到底部 TabBar 均为高质感底色 #F2F5F8 */
page {
  background-color: #F2F5F8 !important;
  background: #F2F5F8 !important;
  min-height: 100vh;
}

.page {
  background-color: #F2F5F8 !important;
  background: #F2F5F8 !important;
  min-height: 100vh;
  box-sizing: border-box;
}

.screen {
  background: transparent !important;
  background-color: transparent !important;
  padding: 0 0 calc(140rpx + max(20rpx, env(safe-area-inset-bottom))) !important;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 导航区补全局边距（.screen 的横向 padding 在本页被置 0，由各内容块自管 32rpx） */
.spaces-nav {
  padding: 12rpx 32rpx 0;
}

/* 2. 顶部规划通栏（对齐首页顶部搜索栏大圆角风格 24rpx） */
.tip-bar {
  margin: 16rpx 32rpx 20rpx;
  height: 84rpx;
  background: #EBF8F5;
  border: 1rpx solid #D2EFE9;
  border-radius: 24rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.tip-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #12A5A0;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tip-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* 3. 空间卡片流容器（节点内部样式由 space-node 组件自管） */
.spaces-scroll {
  padding: 0 32rpx;
}

/* 3.1 根列表拖拽插入线（组件内同级线由 space-node 自绘） */
.spaces-scroll .drag-line {
  height: 6rpx;
  margin: 6rpx 8rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #1DB59B, #0E9B85);
  box-shadow: 0 0 8rpx rgba(18, 165, 160, 0.4);
}

/* 3.2 拖拽幽灵卡 */
.drag-ghost {
  position: fixed;
  left: 44rpx;
  right: 44rpx;
  margin-top: -34rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(18, 165, 160, 0.35);
  box-shadow: 0 16rpx 40rpx rgba(18, 78, 91, 0.22);
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  z-index: 997;
  opacity: 0;
  pointer-events: none;
  transform: scale(0.98);
  transition: opacity 0.12s ease;
  box-sizing: border-box;
}

.drag-ghost.is-visible {
  opacity: 1;
  transform: scale(1.02);
}

.ghost-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.ghost-meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ghost-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #124E5B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ghost-count {
  font-size: 22rpx;
  color: #8FA8AD;
}

/* 4. 状态加载与错误 */
.state-box {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #E0EFEA;
  border-top-color: #20B4AF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-text {
  font-size: 26rpx;
  color: #9CB4BE;
}

.state-err {
  color: #E06B6B;
  padding: 16rpx 32rpx;
  background: #FFF5F5;
  border-radius: 999rpx;
}

/* 5. 底部操作区 */
.bottom-actions {
  margin: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.btn-main {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-plus {
  font-size: 34rpx;
  margin-right: 8rpx;
  font-weight: 500;
}

.bottom-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8FA8AD;
  text-align: center;
}

/* 6. 空白状态 */
.empty-state {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #E8F7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  width: 68rpx;
  height: 68rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #124E5B;
}

.empty-desc {
  font-size: 24rpx;
  color: #8FA8AD;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
}

/* 7. 自定义空间统一操作弹层（S4，取代原生 ActionSheet） */
.custom-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(14, 46, 59, 0.45);
  z-index: 998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
  backdrop-filter: blur(2px);
}

.custom-modal-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.custom-modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  box-shadow: 0 -8rpx 32rpx rgba(18, 78, 91, 0.12);
  padding: 16rpx 36rpx calc(36rpx + max(20rpx, env(safe-area-inset-bottom)));
  box-sizing: border-box;
}

.custom-modal-sheet.is-visible {
  transform: translateY(0);
}

.modal-handle-bar {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 20rpx;
}

.modal-handle {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E2EAEB;
}

.modal-space-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 8rpx 28rpx;
  border-bottom: 1rpx solid #F0F6F7;
}

.modal-space-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.modal-space-meta {
  flex: 1;
  min-width: 0;
}

.modal-space-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #124E5B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.modal-space-sub {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 4rpx;
}

.modal-actions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 28rpx 0 32rpx;
}

.modal-action-card {
  background: #F8FAFA;
  border: 1rpx solid #EEF5F6;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-action-card.act-danger {
  background: #FDF7F7;
  border-color: #F8E8E8;
}

.modal-action-card.act-danger.is-disabled {
  opacity: 0.75;
}

.modal-act-left {
  flex: 1;
  min-width: 0;
}

.modal-act-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #124E5B;
}

.modal-act-title.title-danger {
  color: #E06B6B;
}

.modal-act-desc {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 6rpx;
}

.modal-act-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.modal-cancel-btn {
  height: 90rpx;
  background: #F2F5F8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #8FA8AD;
}

/* 移动空间目标选择弹层 */
.move-targets-scroll {
  max-height: 52vh;
  margin: 16rpx 0 24rpx;
}

.move-targets-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.move-target-item {
  background: #F8FAFA;
  border: 1rpx solid #EEF5F6;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.move-target-item:active {
  background: #EFF6F7;
}

.move-target-item.is-disabled {
  opacity: 0.45;
  background: #F5F7F7;
}

.move-target-item.is-current {
  border-color: rgba(18, 165, 160, 0.35);
  background: #F0FAF8;
}

.move-target-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.move-target-icon {
  font-size: 28rpx;
}

.move-target-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #124E5B;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.move-target-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(18, 165, 160, 0.12);
  color: #12A5A0;
  font-weight: 600;
}

.move-target-badge.is-self {
  background: rgba(143, 168, 173, 0.15);
  color: #8FA8AD;
}

.move-target-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}
