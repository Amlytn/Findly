/* 空间管理 */

/* 1. 沉底色全局覆盖：确保整个页面从状态栏到底部 TabBar 均为高质感底色 #F4F7F6，彻底告别“全白无沉底色” */
page {
  background-color: #F4F7F6 !important;
  background: #F4F7F6 !important;
  min-height: 100vh;
}

.page {
  background-color: #F4F7F6 !important;
  background: #F4F7F6 !important;
  min-height: 100vh;
  box-sizing: border-box;
}

.screen {
  background: transparent !important;
  background-color: transparent !important;
  padding: 0 0 calc(140rpx + max(20rpx, env(safe-area-inset-bottom))) !important;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 导航区补全局边距（.screen 的横向 padding 在本页被置 0，由各内容块自管 32rpx）：左右与其他页对齐，顶部对齐 .screen 的 12rpx 顶距 */
.spaces-nav {
  padding: 12rpx 32rpx 0;
}

/* 2. 顶部规划通栏（对齐首页顶部搜索栏大圆角风格 24rpx） */
.tip-bar {
  margin: 16rpx 32rpx 20rpx;
  height: 84rpx;
  background: #EBF8F5;
  border: 1rpx solid #D2EFE9;
  border-radius: 24rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.tip-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #12A5A0;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tip-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* 3. 根空间分组头部（Section Header） */
.spaces-scroll {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-group {
  margin-bottom: 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 14rpx;
}

.sec-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.sec-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #124E5B;
  letter-spacing: 0.5rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sec-count {
  font-size: 24rpx;
  color: #8FA8AD;
  font-weight: 400;
  margin-left: 4rpx;
}

.sec-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.sec-act-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #EBF8F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sec-act-btn.sec-act-settings {
  background: #F0F3F4;
}

.sec-act-plus {
  font-size: 32rpx;
  color: #12A5A0;
  font-weight: 600;
  line-height: 1;
}

.sec-act-icon {
  width: 28rpx;
  height: 28rpx;
}

.sec-toggle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F0F6F7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.sec-empty-wrap {
  margin: 6rpx 32rpx 16rpx;
}

.sec-empty-card {
  background: rgba(255, 255, 255, 0.6);
  border: 2rpx dashed #D2E8E4;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.sec-empty-tip {
  font-size: 24rpx;
  color: #12A5A0;
  font-weight: 500;
}

.sec-toggle.is-collapsed {
  transform: rotate(-90deg);
}

.sec-arrow {
  width: 26rpx;
  height: 26rpx;
}

/* 4. 子空间卡片流（纯白 Squircle 浮动卡片） */
.cards-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
  padding: 0 32rpx;
}

.sp-card {
  margin: 0 32rpx;
  background: #FFFFFF !important;
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(18, 78, 91, 0.04);
  border: 1rpx solid rgba(18, 78, 91, 0.04);
  box-sizing: border-box;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.card-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.card-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #124E5B;
  letter-spacing: 0.5rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-count {
  font-size: 24rpx;
  color: #8FA8AD;
  font-weight: 400;
  flex-shrink: 0;
}

.card-path {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.3rpx;
}

.card-arrow-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F0F6F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: transform 0.25s ease, background-color 0.2s ease;
}

.card-arrow-box.arrow-down {
  transform: rotate(90deg);
  background: #EBF8F5;
}

.card-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* 5. 内联展开面板（分层解耦排版：1层专属操作条 + 2层物品统计 + 3层物品流） */
.sp-card.is-expanded {
  border-bottom-left-radius: 8rpx;
  border-bottom-right-radius: 8rpx;
  border-color: rgba(18, 165, 160, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(18, 78, 91, 0.08);
}

.in-panel {
  margin: -6rpx 32rpx 14rpx;
  background: #FFFFFF;
  border-radius: 0 0 24rpx 24rpx;
  border: 1rpx solid rgba(18, 78, 91, 0.06);
  border-top: none;
  padding: 22rpx 24rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(18, 78, 91, 0.04);
  box-sizing: border-box;
}

/* 根空间叶子节点直接展开时的容器形态 */
.section-group > .in-panel {
  margin-top: 6rpx;
  border-top: 1rpx solid rgba(18, 78, 91, 0.06);
  border-radius: 24rpx;
}

/* 第一层：专属空间管理工具栏（独立成行，等宽均分，绝不与标题竞争横向宽度，无 emoji） */
.panel-act-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.panel-act-btn {
  flex: 1;
  height: 70rpx;
  border-radius: 18rpx;
  background: #F0F6F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #124E5B;
  box-sizing: border-box;
}

.panel-act-btn.act-add {
  background: #EBF8F5;
  color: #12A5A0;
}

.panel-act-btn.act-del {
  background: #FDF2F2;
  color: #E06B6B;
}

/* 第二层：物品统计信息行（纯粹独立，无按钮抢占，自适应宽裕） */
.panel-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 4rpx 14rpx;
  border-bottom: 1rpx solid #F2F5F5;
  margin-bottom: 16rpx;
}

.panel-head-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #124E5B;
  letter-spacing: 0.5rpx;
}

.panel-head-badge {
  font-size: 22rpx;
  color: #12A5A0;
  background: #EBF8F5;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 第三层：物品流 / 加载中 / 友好空态提示 */
.panel-loading {
  padding: 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.panel-loading-text {
  font-size: 24rpx;
  color: #8FA8AD;
}

.panel-empty {
  padding: 30rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.panel-empty-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.35;
  margin-bottom: 10rpx;
}

.panel-empty-title {
  font-size: 24rpx;
  color: #8FA8AD;
  font-weight: 500;
}

.panel-empty-desc {
  font-size: 22rpx;
  color: #B0C4C8;
  margin-top: 6rpx;
}

.panel-item-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.p-item-card {
  background: #F8FAFA;
  border: 1rpx solid #EEF5F6;
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.p-item-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2EFEA;
  flex-shrink: 0;
}

.p-item-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.p-item-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #124E5B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.p-item-meta {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.p-item-arrow {
  width: 22rpx;
  height: 22rpx;
  opacity: 0.4;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 状态加载与错误 */
.state-box {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #E0EFEA;
  border-top-color: #20B4AF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-text {
  font-size: 26rpx;
  color: #9CB4BE;
}

.state-err {
  color: #E06B6B;
  padding: 16rpx 32rpx;
  background: #FFF5F5;
  border-radius: 999rpx;
}

/* 6. 底部操作区（随页面自然流布局，彻底移除破坏底色的浮动白色渐变罩） */
.bottom-actions {
  margin: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.btn-main {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-plus {
  font-size: 34rpx;
  margin-right: 8rpx;
  font-weight: 500;
}

.bottom-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8FA8AD;
  text-align: center;
}

/* 7. 空白状态 */
.empty-state {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #E8F7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  width: 68rpx;
  height: 68rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #124E5B;
}

.empty-desc {
  font-size: 24rpx;
  color: #8FA8AD;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
}

/* 8. 自定义空间设置弹层（取代原生 ActionSheet） */
.custom-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(14, 46, 59, 0.45);
  z-index: 998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
  backdrop-filter: blur(2px);
}

.custom-modal-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.custom-modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  box-shadow: 0 -8rpx 32rpx rgba(18, 78, 91, 0.12);
  padding: 16rpx 36rpx calc(36rpx + max(20rpx, env(safe-area-inset-bottom)));
  box-sizing: border-box;
}

.custom-modal-sheet.is-visible {
  transform: translateY(0);
}

.modal-handle-bar {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 20rpx;
}

.modal-handle {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E2EAEB;
}

.modal-space-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 8rpx 28rpx;
  border-bottom: 1rpx solid #F0F6F7;
}

.modal-space-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.modal-space-meta {
  flex: 1;
  min-width: 0;
}

.modal-space-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #124E5B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.modal-space-sub {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 4rpx;
}

.modal-actions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 28rpx 0 32rpx;
}

.modal-action-card {
  background: #F8FAFA;
  border: 1rpx solid #EEF5F6;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-action-card.act-danger {
  background: #FDF7F7;
  border-color: #F8E8E8;
}

.modal-act-left {
  flex: 1;
  min-width: 0;
}

.modal-act-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #124E5B;
}

.modal-act-title.title-danger {
  color: #E06B6B;
}

.modal-act-desc {
  font-size: 22rpx;
  color: #8FA8AD;
  margin-top: 6rpx;
}

.modal-act-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.modal-cancel-btn {
  height: 90rpx;
  background: #F4F7F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #8FA8AD;
}

/* 同级排序操作行 */
.modal-reorder-row {
  cursor: default;
}

.reorder-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reorder-btn {
  padding: 12rpx 20rpx;
  background: #EBF8F5;
  border-radius: 12rpx;
  border: 1rpx solid rgba(18, 165, 160, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.reorder-btn:active {
  background: #D5F1EB;
}

.reorder-btn.is-disabled {
  background: #F4F7F7;
  border-color: #E2ECEE;
  opacity: 0.45;
  pointer-events: none;
}

.reorder-txt {
  font-size: 24rpx;
  font-weight: 600;
  color: #12A5A0;
}

.reorder-btn.is-disabled .reorder-txt {
  color: #8FA8AD;
}

/* 移动空间目标选择弹层 */
.move-targets-scroll {
  max-height: 52vh;
  margin: 16rpx 0 24rpx;
}

.move-targets-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.move-target-item {
  background: #F8FAFA;
  border: 1rpx solid #EEF5F6;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.move-target-item:active {
  background: #EFF6F7;
}

.move-target-item.is-disabled {
  opacity: 0.45;
  background: #F5F7F7;
}

.move-target-item.is-current {
  border-color: rgba(18, 165, 160, 0.35);
  background: #F0FAF8;
}

.move-target-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.move-target-icon {
  font-size: 28rpx;
}

.move-target-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #124E5B;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.move-target-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(18, 165, 160, 0.12);
  color: #12A5A0;
  font-weight: 600;
}

.move-target-badge.is-self {
  background: rgba(143, 168, 173, 0.15);
  color: #8FA8AD;
}

.move-target-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
}
