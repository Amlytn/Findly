/* 空间管理 · 1:1 像素级复刻设计稿 */

/* 1. 沉底色全局覆盖：确保整个页面从状态栏到底部 TabBar 均为高质感底色 #F4F7F6，彻底告别“全白无沉底色” */
page {
  background-color: #F4F7F6 !important;
  background: #F4F7F6 !important;
  min-height: 100vh;
}

.page {
  background-color: #F4F7F6 !important;
  background: #F4F7F6 !important;
  min-height: 100vh;
  box-sizing: border-box;
}

.screen {
  background: transparent !important;
  background-color: transparent !important;
  padding: 0 0 calc(140rpx + max(20rpx, env(safe-area-inset-bottom))) !important;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 2. 顶部规划通栏（对齐设计稿） */
.tip-bar {
  margin: 16rpx 32rpx 20rpx;
  background: #EBF8F5;
  border: 1rpx solid #D2EFE9;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.tip-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #12A5A0;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.tip-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.5;
}

/* 3. 根空间分组头部（Section Header） */
.spaces-scroll {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-group {
  margin-bottom: 8rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 14rpx;
}

.sec-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.sec-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0E2E3B;
  letter-spacing: 0.5rpx;
}

.sec-count {
  font-size: 26rpx;
  color: #9CB4BE;
  font-weight: 400;
  margin-left: 4rpx;
}

.sec-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDF5F8;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.sec-toggle.is-collapsed {
  transform: rotate(-90deg);
}

.sec-arrow {
  width: 26rpx;
  height: 26rpx;
}

/* 4. 子空间卡片流（纯白 Squircle 浮动卡片） */
.cards-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
}

.sp-card {
  margin: 0 32rpx;
  background: #FFFFFF !important;
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 14rpx rgba(14, 46, 59, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-sizing: border-box;
}

.sp-card:active {
  transform: scale(0.985);
  background: #FAFCFC !important;
}

.sp-card.is-selected {
  border-color: #20B4AF;
  background: #F4FBFA !important;
  box-shadow: 0 6rpx 20rpx rgba(32, 180, 175, 0.12);
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.card-info {
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0E2E3B;
  letter-spacing: 0.5rpx;
}

.card-count {
  font-size: 26rpx;
  color: #9CB4BE;
  font-weight: 400;
}

.card-path {
  font-size: 22rpx;
  color: #9CB4BE;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.3rpx;
}

.card-arrow-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDF5F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.card-arrow-box.arrow-down {
  transform: rotate(90deg);
  background: #E0F5F2;
}

.card-arrow {
  width: 26rpx;
  height: 26rpx;
}

/* 5. 展开的物品面板 */
.items-panel {
  margin: 10rpx 32rpx 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #D6EFEA;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(14, 46, 59, 0.03);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EEF6F4;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0E2E3B;
}

.panel-actions {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #F4FAF8;
  border: 1rpx solid #B8E6DE;
  color: #0FA47F;
  font-weight: 500;
}

.action-btn.action-add {
  background: #E8F8F5;
  border-color: #20B4AF;
  color: #20B4AF;
}

.action-btn.action-del {
  background: #FFF5F5;
  border-color: #F8D7D7;
  color: #E06B6B;
}

.items-loading,
.items-empty {
  padding: 30rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9CB4BE;
}

.items-list {
  margin-top: 8rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EEF6F4;
}

.item-card:last-child {
  border-bottom: none;
}

.item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F7FAF9;
  flex-shrink: 0;
  border: 1rpx solid #E2EFEA;
}

.item-info {
  margin-left: 18rpx;
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0E2E3B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-meta {
  font-size: 22rpx;
  color: #9CB4BE;
  margin-top: 4rpx;
}

.item-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

/* 6. 快捷扩展推荐（对齐设计稿的丰富分类，提高空间利用率） */
.quick-rec {
  margin: 28rpx 32rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(14, 46, 59, 0.03);
}

.quick-rec-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0E2E3B;
  margin-bottom: 14rpx;
}

.quick-rec-chips {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.quick-rec-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: #F4FAF8;
  border: 1rpx solid #D1EFE9;
  border-radius: 999rpx;
  transition: all 0.2s;
}

.quick-rec-chip:active {
  background: #E4F7F3;
}

.rec-icon {
  width: 32rpx;
  height: 32rpx;
}

.rec-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #12A5A0;
}

/* 7. 底部操作区（随页面自然流布局，彻底移除破坏底色的浮动白色渐变罩） */
.bottom-actions {
  margin: 36rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.btn-main {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transition: opacity 0.2s;
}

.btn-main:active {
  opacity: 0.88;
}

.btn-plus {
  font-size: 34rpx;
  margin-right: 8rpx;
  font-weight: 500;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-cancel {
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #B8E6DE;
  color: #0FA47F;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(14, 46, 59, 0.03);
}

.btn-cancel:active {
  background: #F0FAF8;
}

.btn-main-sub {
  flex: 1;
  font-size: 28rpx;
}

.btn-sub-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320rpx;
}

.bottom-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9CB4BE;
  text-align: center;
}

/* 8. 空白状态 */
.empty-state {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #E8F7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  width: 68rpx;
  height: 68rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0E2E3B;
}

.empty-desc {
  font-size: 24rpx;
  color: #9CB4BE;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1DB59B, #0E9B85);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
}
