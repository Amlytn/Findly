<view class="page">
  <view class="screen">
    <nav-bar title="搜索结果" />

    <view class="seg">
      <view class="seg-item {{tab === 'all' ? 'on' : ''}}" bindtap="setTab" data-t="all">全部</view>
      <view class="seg-item {{tab === 'item' ? 'on' : ''}}" bindtap="setTab" data-t="item">物品</view>
      <view class="seg-item {{tab === 'space' ? 'on' : ''}}" bindtap="setTab" data-t="space">空间</view>
    </view>

    <view class="cnt">找到 {{count}} 个相关结果<text wx:if="{{parsed}}" class="cnt-src">（{{parsed.source}}）</text></view>

    <view class="empty" wx:if="{{loading}}">搜索中…</view>
    <view class="empty" wx:elif="{{error}}" bindtap="retry">{{error}}</view>

    <block wx:if="{{!loading && !error && tab !== 'space'}}">
      <view class="res-item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image src="{{item.imageUrl || '/assets/item-mouse.jpg'}}" mode="aspectFill" />
        <view class="res-info">
          <view class="res-name">{{item.name}}</view>
          <view class="res-meta">{{item.color}} · {{item.brand}}</view>
          <view class="res-loc">{{item.path}}</view>
        </view>
        <view class="chev"></view>
      </view>
    </block>

    <block wx:if="{{!loading && !error && tab !== 'item'}}">
      <view class="res-item" wx:for="{{spaces}}" wx:key="id" bindtap="goSpaces">
        <view class="sp-chip">
          <view class="ic ic-house"></view>
        </view>
        <view class="res-info">
          <view class="res-name">{{item.name}}</view>
          <view class="res-meta">{{item.path}}</view>
        </view>
        <view class="chev"></view>
      </view>
    </block>

    <view class="empty" wx:if="{{!loading && !error && count === 0}}">没有找到相关结果，换个关键词试试～</view>
  </view>
</view>
