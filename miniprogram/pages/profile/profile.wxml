<view class="page">
  <view class="screen">
    <nav-bar title="个人中心" />

    <view class="p-card">
      <view class="p-avatar avatar"></view>
      <view class="p-info">
        <view class="p-name">小明同学</view>
        <view class="p-sub">开心生活 · Findly</view>
      </view>
    </view>

    <view class="p-list">
      <view class="list-row" bindtap="goItems">
        <view class="ic ic-bag"></view>
        <text class="row-name">我的物品</text>
        <text class="row-extra">12件</text>
        <view class="chev"></view>
      </view>
      <view class="list-row" bindtap="goSpaces">
        <view class="ic ic-home2"></view>
        <text class="row-name">我的空间</text>
        <text class="row-extra">4个</text>
        <view class="chev"></view>
      </view>
      <view class="list-row" bindtap="goFamily">
        <view class="ic ic-people"></view>
        <text class="row-name">我的家庭</text>
        <text class="row-extra">敬请期待</text>
        <view class="chev"></view>
      </view>
      <view class="list-row" bindtap="goSettings">
        <view class="ic ic-gear"></view>
        <text class="row-name">设置</text>
        <view class="chev"></view>
      </view>
    </view>
  </view>
</view>
