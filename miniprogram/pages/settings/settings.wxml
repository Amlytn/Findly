<view class="page">
  <view class="screen">
    <nav-bar title="设置" />

    <view class="g-label">关于</view>
    <view class="g-card">
      <view class="list-row">
        <view class="ic ic-info"></view>
        <text class="row-name">版本信息</text>
        <text class="row-extra">v{{version}}</text>
      </view>
      <view class="list-row" bindtap="doc" data-t="用户协议">
        <view class="ic ic-doc"></view>
        <text class="row-name">用户协议</text>
        <view class="chev"></view>
      </view>
      <view class="list-row" bindtap="doc" data-t="隐私政策">
        <view class="ic ic-shield"></view>
        <text class="row-name">隐私政策</text>
        <view class="chev"></view>
      </view>
      <view class="list-row" bindtap="doc" data-t="常见问题">
        <view class="ic ic-help"></view>
        <text class="row-name">常见问题</text>
        <view class="chev"></view>
      </view>
    </view>

    <view class="g-card">
      <view class="list-row" bindtap="clearCache">
        <view class="ic ic-del"></view>
        <text class="row-name">清除缓存</text>
        <text class="row-extra">12.5MB</text>
        <view class="chev"></view>
      </view>
    </view>

    <view class="logout" bindtap="logout">退出登录</view>
  </view>
</view>
