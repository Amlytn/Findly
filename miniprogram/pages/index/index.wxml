<view class="page" style="padding-top: {{statusBarHeight}}px;">
  <view class="screen">

    <!-- 顶部品牌栏（与胶囊按钮垂直对齐） -->
    <view class="header" style="height: {{navBarHeight}}px;">
      <view class="brand">
        <image class="logo" src="/assets/logo.png" mode="aspectFit" />
        <text class="brand-name">Findly</text>
      </view>
    </view>

    <!-- 搜索栏（点击进入搜索页） -->
    <view class="search-bar" bindtap="goSearch">
      <view class="icon-search"></view>
      <input
        class="search-input"
        placeholder="搜索物品、空间、或描述..."
        placeholder-class="search-ph"
        disabled
      />
    </view>

    <!-- 拍照识别横幅（3D 渐变场景背景图 + 真实文字/徽章叠加，比例对齐设计稿 686x354rpx） -->
    <view class="hero" bindtap="onHeroTap">
      <image class="hero-bg" src="/assets/hero-bg.jpg" mode="aspectFill" />
      <view class="hero-text">
        <view class="hero-line">拍一张照片</view>
        <view class="hero-line">AI帮你识别物品</view>
      </view>
      <view class="hero-cam"></view>
    </view>

    <!-- 快捷入口（四个均为 3D 图标） -->
    <view class="section-title">快捷入口</view>
    <view class="quick">
      <view class="quick-card" bindtap="goCamera">
        <image class="quick-ico" src="/assets/icon-camera-3d.png" mode="aspectFit" />
        <text class="quick-name">拍照识别</text>
      </view>
      <view class="quick-card" bindtap="goItems">
        <image class="quick-ico" src="/assets/icon-items-3d.png" mode="aspectFit" />
        <text class="quick-name">我的物品</text>
      </view>
      <view class="quick-card" bindtap="goSpaces">
        <image class="quick-ico" src="/assets/icon-space-3d.png" mode="aspectFit" />
        <text class="quick-name">空间管理</text>
      </view>
      <view class="quick-card" bindtap="goRecent">
        <image class="quick-ico" src="/assets/icon-recent-3d.png" mode="aspectFit" />
        <text class="quick-name">最近查看</text>
      </view>
    </view>

    <!-- 最近添加 -->
    <view class="section-head">
      <view class="section-title">最近添加</view>
      <text class="see-all" bindtap="goItems">查看全部</text>
    </view>
    <view class="recent">
      <view
        class="recent-item"
        wx:for="{{recentItems}}"
        wx:key="name"
        bindtap="onItemTap"
        data-id="{{item.id}}"
      >
        <image class="recent-img" src="{{item.img}}" mode="aspectFill" />
        <view class="recent-name">{{item.name}}</view>
        <view class="recent-meta">{{item.space}} · {{item.time}}</view>
      </view>
    </view>

  </view>
</view>
