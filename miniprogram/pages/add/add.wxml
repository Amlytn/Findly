<view class="page">
  <view class="screen add-screen">
    <nav-bar title="添加物品" />

    <view class="add-hero">
      <view class="add-blob add-blob-l"></view>
      <view class="add-blob add-blob-r"></view>

      <view class="add-cam-wrap">
        <view class="add-cam-halo"></view>
        <view class="add-cam"></view>
      </view>

      <view class="add-title">拍照识别</view>
      <view class="add-sub">AI 自动识别物品信息</view>

      <view class="btn-primary add-btn" bindtap="goCamera">
        <view class="btn-ic btn-ic-w"></view>
        <text>AI 拍摄识别</text>
      </view>
      <view class="btn-outline add-btn" bindtap="manualAdd">
        <view class="btn-ic btn-ic-t"></view>
        <text>手动添加</text>
      </view>
    </view>
  </view>
</view>
