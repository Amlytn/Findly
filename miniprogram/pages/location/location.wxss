/* 位置选择页 · 现代化 Squircle 卡片风格 */
.page {
  background: #F7FAF9;
  min-height: 100vh;
}

.screen {
  padding-bottom: 220rpx;
}

/* 状态加载与错误 */
.state-box {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0EFEA;
  border-top-color: #20B4AF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.state-text {
  font-size: 26rpx;
  color: #9CB4BE;
}

.state-err {
  color: #E06B6B;
  padding: 16rpx 32rpx;
  background: #FFF5F5;
  border-radius: 999rpx;
}

/* 空态引导 */
.empty-state {
  padding: 140rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-box {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #E8F7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  width: 68rpx;
  height: 68rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0E2E3B;
}

.empty-desc {
  font-size: 24rpx;
  color: #9CB4BE;
  margin-top: 10rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #20B4AF, #0FA47F);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(15, 164, 127, 0.28);
}

/* 空间卡片列表 */
.loc-list {
  padding: 16rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.loc-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 10rpx rgba(14, 46, 59, 0.03);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.loc-card:active {
  transform: scale(0.985);
}

.loc-card.is-selected {
  border-color: #20B4AF;
  background: #F4FBFA;
  box-shadow: 0 6rpx 20rpx rgba(32, 180, 175, 0.12);
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.card-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
}

.card-info {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0E2E3B;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-count {
  font-size: 24rpx;
  color: #9CB4BE;
  flex-shrink: 0;
}

.card-path {
  font-size: 22rpx;
  color: #9CB4BE;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 选中勾选框 */
.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #C7D6D9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: all 0.2s;
}

.check-box.is-checked {
  border-color: #20B4AF;
  background: #20B4AF;
}

.check-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

/* 底部操作区（悬浮吸底） */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 36rpx calc(env(safe-area-inset-bottom) + 30rpx);
  background: linear-gradient(to top, rgba(247, 250, 249, 1) 75%, rgba(247, 250, 249, 0));
  z-index: 50;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-outline-add {
  height: 96rpx;
  padding: 0 36rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #B8E6DE;
  color: #0FA47F;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-outline-add:active {
  background: #F0FAF8;
}

.btn-confirm {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #20B4AF, #0FA47F);
  box-shadow: 0 10rpx 24rpx rgba(15, 164, 127, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  transition: opacity 0.2s;
}

.btn-confirm:active {
  opacity: 0.88;
}
