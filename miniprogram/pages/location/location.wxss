.root-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0 20rpx;
}

.root-row .name {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F4C5A;
  margin-left: 16rpx;
}

.root-row .meta {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9AB0B4;
  flex: 1;
}

/* 树形分组 */
.group {
  margin-left: 44rpx;
  border-left: 2rpx solid #E4EFF0;
  padding-left: 28rpx;
}

.g-head {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.g-head .name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F4C5A;
  margin-left: 16rpx;
}

.g-head .meta {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9AB0B4;
  flex: 1;
}

.g-body {
  padding-left: 64rpx;
  padding-bottom: 8rpx;
}

.leaf {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.leaf.sel {
  background: #E4F6F3;
}

.leaf-name {
  flex: 1;
  font-size: 28rpx;
  color: #124E5B;
}

.l-confirm {
  margin-top: 56rpx;
}

/* 平铺全深度选择列表（任意层级空间均可选） */
.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin: 16rpx 32rpx 0;
}

.loc-row.sel {
  background: #EAF6F5;
}

.loc-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.loc-name {
  font-size: 30rpx;
  color: #124E5B;
  font-weight: 500;
}

.loc-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #93A9AE;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ic-radio {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx solid #C7D6D9;
}

.ic-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #12A5A0;
}
