<view class="page">
  <view class="screen">
    <nav-bar title="选择位置" />

    <view class="empty" wx:if="{{loading}}">空间加载中…</view>
    <view class="empty" wx:elif="{{error}}">{{error}}</view>

    <view
      class="loc-row {{selIndex === index ? 'sel' : ''}}"
      wx:for="{{rows}}"
      wx:key="id"
      style="padding-left: {{item.pad}}rpx;"
      bindtap="select"
      data-i="{{index}}"
    >
      <view class="loc-main">
        <text class="loc-name">{{item.name}}</text>
        <text class="loc-sub">{{item.pathText}}</text>
      </view>
      <view class="ic {{selIndex === index ? 'ic-check' : 'ic-radio'}}"></view>
    </view>

    <view class="btn-primary l-confirm" bindtap="confirm">确定</view>
  </view>
</view>
