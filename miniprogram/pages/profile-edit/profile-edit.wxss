/* ================= 个人资料编辑 ================= */
/* 卡片容器与设置页同款（页面样式不跨页共享，此处独立声明） */
.g-card {
  background: #FFFFFF;
  border: 2rpx solid #EEF5F6;
  border-radius: 28rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 28rpx;
}

.e-label {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F4C5A;
}

.e-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.e-hint {
  font-size: 24rpx;
  color: #9AB0B4;
  margin: 0 12rpx 0 20rpx;
}

.e-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #0F4C5A;
}

.e-ph {
  color: #C2CFD2;
}

.e-tip {
  font-size: 24rpx;
  color: #9AB0B4;
  text-align: center;
  margin-top: 8rpx;
}

/* 保存按钮复用全局 .btn-primary（品牌渐变圆角），这里只补位置 */
.e-save {
  margin-top: 60rpx;
}

/* 保存中：置灰防连点（ts 层另有 saving 闸） */
.e-save.e-saving {
  opacity: 0.6;
}
