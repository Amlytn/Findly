/* 空间表单弹层 —— 视觉对齐 spaces 页 custom-modal 体系 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(14, 46, 59, 0.45);
  z-index: 998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
  backdrop-filter: blur(2px);
}

.modal-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  box-shadow: 0 -8rpx 32rpx rgba(18, 78, 91, 0.12);
  padding: 16rpx 36rpx calc(36rpx + max(20rpx, env(safe-area-inset-bottom)));
  box-sizing: border-box;
  /* 高度由内容决定（正好容纳当前分类全部图标），小屏极端情况 82vh 封顶、中部可滚兜底 */
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}

.modal-sheet.is-visible {
  transform: translateY(0);
}

/* 指示条兼拖高把手：加大热区方便抓握 */
.modal-handle-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx 0 20rpx;
  margin: -8rpx 0 0;
}

/* 可滚动表单区（图标网格超出时上下滑动，按钮始终可见） */
.sheet-scroll {
  flex: 1;
  min-height: 0;
}

.modal-handle {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E2EAEB;
}

.modal-title-row {
  padding: 0 8rpx 24rpx;
  border-bottom: 1rpx solid #F0F6F7;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #124E5B;
}

.modal-title-sub {
  font-size: 24rpx;
  color: #8FA8AD;
  margin-top: 6rpx;
}

/* 表单域 */
.form-field {
  margin-top: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #124E5B;
  margin-bottom: 16rpx;
}

.field-label-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #A8BCC0;
  margin-left: 8rpx;
}

.field-input {
  background: #F6FAFA;
  border: 1rpx solid #E6EFF0;
  border-radius: 20rpx;
  height: 92rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #124E5B;
  box-sizing: border-box;
}

.field-placeholder {
  color: #B9C9CC;
}

/* 图标选择：分类 tab */
.form-field-icon {
  margin-top: 32rpx;
}

.cat-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
  width: 100%;
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 30rpx;
  margin-right: 16rpx;
  background: #F4F7F6;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #6E878C;
  flex-shrink: 0;
}

.cat-tab.is-active {
  background: linear-gradient(135deg, #31CBBB, #04869D);
  color: #FFFFFF;
  font-weight: 600;
}

/* 图标网格：每行 4 个 */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-cell {
  position: relative;
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 16rpx;
  background: #F8FAFA;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.icon-cell.is-selected {
  background: #EAF7F7;
  border-color: #12A5A0;
}

.icon-img {
  width: 64rpx;
  height: 64rpx;
}

.icon-label {
  font-size: 22rpx;
  color: #6E878C;
  margin-top: 8rpx;
}

.icon-cell.is-selected .icon-label {
  color: #0D8A86;
  font-weight: 600;
}

.icon-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #31CBBB, #04869D);
}

.icon-check::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 8rpx;
  height: 13rpx;
  border: solid #FFFFFF;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

/* 底部按钮 */
.modal-btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-cancel {
  flex: 1;
  height: 92rpx;
  background: #F4F7F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #8FA8AD;
}

.btn-confirm {
  flex: 2;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #31CBBB, #04869D);
  box-shadow: 0 10rpx 24rpx rgba(18, 165, 160, 0.28);
}

.btn-confirm.is-disabled {
  opacity: 0.6;
}
