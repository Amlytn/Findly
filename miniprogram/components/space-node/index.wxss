/* 空间节点（space-node）：根卡 + 卡内扁平树。
   所有层级同尺寸，层级只靠缩进与短竖线表达；灰底只铺根的直接子空间列表。 */

:host {
  display: block;
}

.node-root {
  display: block;
  margin-bottom: 24rpx;
}

.node-child {
  display: block;
}

/* ---------- 根卡片 ---------- */
.sp-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 45, 61, 0.06);
  box-sizing: border-box;
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}

.sp-card.is-open {
  box-shadow: 0 16rpx 48rpx rgba(31, 45, 61, 0.08);
}

.sp-card.is-dragging {
  opacity: 0.35;
  box-shadow: none;
}

.rc-head {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.rc-icon {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 新版图标画布 116、卡片 96：放大 116/96 让底卡正好填满槽位，余量留给卡片投影 */
.rc-icon-img {
  width: 120.833%;
  height: 120.833%;
  flex: none;
  display: block;
}

.rc-meta {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rc-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #124E5B;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rc-count {
  font-size: 24rpx;
  color: #9AA9B4;
}

.rc-act {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.rc-act-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.55;
}

.rc-toggle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 14rpx;
  transition: transform 0.25s ease;
}

.sp-card.is-open > .rc-head > .rc-toggle {
  transform: rotate(180deg);
}

.rc-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.5;
}

/* ---------- 根卡展开体 ---------- */
.rc-body.is-root {
  border-top: 1rpx solid #EEF2F3;
  padding: 20rpx 24rpx 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 16rpx;
}

.sec-head-items {
  margin-top: 24rpx;
}

.sec-ico {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sec-ico-img {
  width: 120.833%;
  height: 120.833%;
  flex: none;
  display: block;
}

.sec-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #124E5B;
}

.sec-count {
  font-size: 24rpx;
  color: #9AA9B4;
}

.sec-add {
  margin-left: auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #12A5A0;
  padding: 6rpx 4rpx 6rpx 12rpx;
}

.sec-add:active {
  opacity: 0.6;
}

.sec-add-plus {
  font-size: 30rpx;
  line-height: 1;
}

/* ---------- 灰底列表 / 子空间行 ---------- */
.sp-list {
  background: #F5F8FA;
  border-radius: 24rpx;
  padding: 6rpx 8rpx;
}

.tnode {
  position: relative;
  display: block;
}

/* 同级相邻行之间一条发丝线；展开体不参与 */
.tnode.has-sep {
  border-top: 1rpx solid #E9EFF3;
}

.trow {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  transition: background 0.12s ease;
}

.trow:active {
  background: #E9EEF2;
}

.t-ico {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.t-ico-img {
  width: 120.833%;
  height: 120.833%;
  flex: none;
  display: block;
}

.t-name {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  color: #124E5B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.t-name.is-open {
  color: #12A5A0;
}

.t-count {
  font-size: 24rpx;
  color: #9AA9B4;
  flex-shrink: 0;
}

.t-count.zero {
  color: #C2CDD4;
}

.disclosure {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.25s ease;
}

.t-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.5;
}

.tnode.open > .trow .disclosure {
  transform: rotate(180deg);
}

/* 二层及更深的子行左侧一小段竖线，接住父行的层级；第一层直接铺在灰底列表里，不画线 */
.trow.is-deep::before {
  content: "";
  position: absolute;
  left: -22rpx;
  top: -2rpx;
  bottom: -2rpx;
  width: 3rpx;
  border-radius: 2rpx;
  background: #E3EAEF;
}

/* 展开体每深一层缩进 26px 的一半：16px 外边距 + 10px 内边距 */
.tkids {
  margin-left: 32rpx;
  padding-left: 20rpx;
  animation: tkids-in 0.22s ease;
}

@keyframes tkids-in {
  from {
    opacity: 0;
    transform: translateY(-4rpx);
  }
}

/* ---------- 物品货架：固定瓦片，按可用宽度换行 ---------- */
.tiles {
  display: grid;
  grid-template-columns: repeat(auto-fill, 148rpx);
  gap: 20rpx;
  justify-content: start;
  padding: 4rpx 0 12rpx;
}

.tile {
  width: 148rpx;
}

.tile-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 22rpx;
  background: #E6ECF1;
  object-fit: cover;
  display: block;
}

.tile-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5E7180;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tile-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8ECF1;
}

.tile-more-txt {
  font-size: 36rpx;
  color: #9AA9B4;
  letter-spacing: 2rpx;
  line-height: 1;
}

.tile.is-highlight .tile-img {
  box-shadow: 0 0 0 4rpx rgba(18, 165, 160, 0.35);
  animation: tile-pulse 0.9s ease-in-out 3;
}

@keyframes tile-pulse {
  0%, 100% {
    box-shadow: 0 0 0 4rpx rgba(18, 165, 160, 0.35);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(18, 165, 160, 0.12);
  }
}

/* ---------- 加载 / 空态 ---------- */
.mod-loading {
  padding: 30rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.mod-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E4EAF0;
  border-top-color: #20B4AF;
  border-radius: 50%;
  animation: node-spin 0.8s linear infinite;
}

@keyframes node-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.mod-loading-text {
  font-size: 24rpx;
  color: #9AA9B4;
}

.mod-empty {
  padding: 12rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: #9AA9B4;
}

/* 子空间展开体底部的轻量操作行：添加物品 / 添加空间 / 管理 */
.child-actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 6rpx;
  padding: 14rpx 8rpx 4rpx;
  border-top: 1rpx dashed #E3EAEF;
}

.child-act {
  font-size: 22rpx;
  font-weight: 600;
  color: #12A5A0;
  padding: 6rpx 0;
}

.child-act.manage {
  color: #8FA8AD;
}

/* 拖拽插入位置指示线 */
.drag-line {
  height: 6rpx;
  margin: 4rpx 8rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #1DB59B, #0E9B85);
  box-shadow: 0 0 8rpx rgba(18, 165, 160, 0.4);
}
