/* 空间节点（space-node）：一张白色大卡承载头部 + 卡内浅灰蓝模块，逐层就地展开 */

/* 层级缩进：depth 0 无缩进，1 级缩 10rpx，2+ 级缩 20rpx（防无限右移） */
.node-d0 { padding-left: 0; }
.node-d1 { padding-left: 10rpx; }
.node-d2 { padding-left: 20rpx; }

.node {
  margin-bottom: 14rpx;
}

/* 根卡片之间留更足的呼吸（组件样式隔离，用同元素的 node-d0 类区分） */
.node-d0 {
  margin-bottom: 24rpx;
}

/* ---------- 白色大卡（头 + 展开体一体） ---------- */
.sp-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 45, 61, 0.05);
  box-sizing: border-box;
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}

.node-d1 .sp-card,
.node-d2 .sp-card {
  border-radius: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 61, 0.04);
}

.sp-card.is-open {
  box-shadow: 0 12rpx 36rpx rgba(31, 45, 61, 0.08);
}

/* ---------- 卡片头 ---------- */
.rc-head {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
}

.node-d1 .rc-head,
.node-d2 .rc-head {
  padding: 18rpx 22rpx;
}

.rc-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
}

.node-d1 .rc-icon,
.node-d2 .rc-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.rc-meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.node-d1 .rc-meta,
.node-d2 .rc-meta {
  margin-left: 18rpx;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.rc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #124E5B;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.node-d1 .rc-name,
.node-d2 .rc-name {
  font-size: 28rpx;
  font-weight: 600;
}

.rc-count {
  font-size: 24rpx;
  color: #9AA9B4;
  font-weight: 400;
}

.rc-act {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.node-d1 .rc-act,
.node-d2 .rc-act {
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  margin-left: 4rpx;
}

.rc-act-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.55;
}

.rc-toggle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 14rpx;
  transition: transform 0.25s ease;
}

.node-d1 .rc-toggle,
.node-d2 .rc-toggle {
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  margin-left: 4rpx;
}

.sp-card.is-open > .rc-head > .rc-toggle {
  transform: rotate(180deg);
}

.rc-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.5;
}

/* ---------- 卡内展开体 ---------- */
.rc-body {
  padding: 0 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.node-d1 .rc-body,
.node-d2 .rc-body {
  padding: 0 16rpx 16rpx;
  gap: 14rpx;
}

/* 模块（物品 / 空间）：卡内浅灰蓝块，无边框 */
.mod {
  background: #F5F7FA;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 20rpx;
  box-sizing: border-box;
}

.node-d1 .mod,
.node-d2 .mod {
  border-radius: 18rpx;
  padding: 18rpx 16rpx 14rpx;
}

.mod-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.mod-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.mod-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #124E5B;
  letter-spacing: 0.5rpx;
}

/* 计数为朴素灰字（对齐设计稿，不做色块徽标） */
.mod-badge {
  font-size: 23rpx;
  color: #9AA9B4;
  font-weight: 400;
}

.mod-add {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #12A5A0;
  padding: 8rpx 4rpx 8rpx 16rpx;
  flex-shrink: 0;
}

.mod-add:active {
  opacity: 0.6;
}

.mod-add-plus {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  margin-right: 2rpx;
}

/* 模块加载 / 空态 */
.mod-loading {
  padding: 30rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.mod-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E4EAF0;
  border-top-color: #20B4AF;
  border-radius: 50%;
  animation: node-spin 0.8s linear infinite;
}

@keyframes node-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.mod-loading-text {
  font-size: 24rpx;
  color: #9AA9B4;
}

.mod-empty {
  padding: 30rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9AA9B4;
  border-radius: 16rpx;
}

/* 物品货架（横向滚动缩略瓦片） */
.item-shelf {
  width: 100%;
  white-space: nowrap;
}

.shelf-tile {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 148rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.shelf-tile:last-child {
  margin-right: 0;
}

.shelf-img-box {
  width: 148rpx;
  height: 148rpx;
  border-radius: 22rpx;
  background: #EEF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.shelf-img {
  width: 148rpx;
  height: 148rpx;
}

.shelf-more-box {
  background: #E8ECF1;
}

.shelf-more-txt {
  font-size: 36rpx;
  color: #9AA9B4;
  line-height: 1;
  letter-spacing: 2rpx;
}

.shelf-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5E7180;
  max-width: 148rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}

/* 搜索回跳高亮的物品瓦片：短暂呼吸描边 */
.shelf-tile.is-highlight .shelf-img-box {
  box-shadow: 0 0 0 4rpx rgba(18, 165, 160, 0.35);
  animation: tile-pulse 0.9s ease-in-out 3;
}

@keyframes tile-pulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(18, 165, 160, 0.35); }
  50% { box-shadow: 0 0 0 12rpx rgba(18, 165, 160, 0.12); }
}

/* 子空间行容器：行与行之间留呼吸 */
.space-rows {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 拖拽：被拖起的原卡片压暗占位 */
.sp-card.is-dragging {
  opacity: 0.35;
  box-shadow: none;
}

/* 拖拽插入位置指示线 */
.drag-line {
  height: 6rpx;
  margin: 4rpx 8rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #1DB59B, #0E9B85);
  box-shadow: 0 0 8rpx rgba(18, 165, 160, 0.4);
}
