<view class="node node-d{{node.depth > 2 ? 2 : node.depth}}">
  <!-- 一张白色大卡承载头部与展开体（设计稿：模块长在卡内，不裸在页面底色上） -->
  <view class="sp-card {{node.depth === 0 ? 'is-root' : 'is-row'}} {{node.expanded ? 'is-open' : ''}} {{drag && drag.dragId === node.id ? 'is-dragging' : ''}}">
    <!-- 卡片头（depth 0 大卡 / depth ≥1 紧凑行，同一结构）；id 挂组件标签上供页面查询兄弟位置 -->
    <view
      class="rc-head"
      bindtap="onTap"
      bindlongpress="onDragStart"
      bindtouchmove="onDragMove"
      bindtouchend="onDragEnd"
      bindtouchcancel="onDragEnd"
    >
      <image class="rc-icon" src="{{node.cardIcon}}" mode="aspectFit" />
      <view class="rc-meta">
        <text class="rc-name">{{node.name}}</text>
        <text class="rc-count">共 {{node.total}} 件</text>
      </view>
      <view class="rc-act" catchtap="onMore" aria-label="管理空间">
        <image class="rc-act-icon" src="/assets/spaces/glyphs/more_horizontal.svg" mode="aspectFit" />
      </view>
      <view class="rc-toggle">
        <image class="rc-arrow" src="/assets/spaces/glyphs/chevron_down.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- 卡内展开体：物品模块 + 空间模块（点模块空白不误收起） -->
    <view class="rc-body" wx:if="{{node.expanded}}" catchtap="noop">
      <!-- 物品模块：直属物品，默认前 4 个，超出显示 ··· -->
      <view class="mod">
        <view class="mod-head">
          <view class="mod-title-wrap">
            <text class="mod-title">物品</text>
            <text class="mod-badge">{{node.directCount}} 件</text>
          </view>
          <view class="mod-add" catchtap="onAddItem">
            <text class="mod-add-plus">＋</text>
            <text>添加物品</text>
          </view>
        </view>

        <view class="mod-loading" wx:if="{{loadingMap[node.id]}}">
          <view class="mod-spinner"></view>
          <text class="mod-loading-text">正在读取物品…</text>
        </view>

        <scroll-view class="item-shelf" wx:elif="{{itemsMap[node.id] && itemsMap[node.id].length}}" scroll-x>
          <view
            class="shelf-tile {{highlightId && highlightId === item.id ? 'is-highlight' : ''}}"
            wx:for="{{itemsMap[node.id]}}"
            wx:key="id"
            wx:if="{{index < 4}}"
            id="item-{{item.id}}"
            catchtap="onTileTap"
            data-id="{{item.id}}"
          >
            <view class="shelf-img-box">
              <image class="shelf-img" src="{{item.img}}" mode="aspectFill" />
            </view>
            <text class="shelf-name">{{item.name}}</text>
          </view>
          <view class="shelf-tile" wx:if="{{itemsMap[node.id].length > 4}}" catchtap="onShowAll">
            <view class="shelf-img-box shelf-more-box">
              <text class="shelf-more-txt">···</text>
            </view>
            <text class="shelf-name">查看全部</text>
          </view>
        </scroll-view>

        <view class="mod-empty" wx:else>
          此空间暂无直接存放的物品
        </view>
      </view>

      <!-- 空间模块：直属子空间行（点击逐层就地展开） -->
      <view class="mod">
        <view class="mod-head">
          <view class="mod-title-wrap">
            <text class="mod-title">空间</text>
            <text class="mod-badge">{{node.children.length}} 个</text>
          </view>
          <view class="mod-add" catchtap="onAddSpace">
            <text class="mod-add-plus">＋</text>
            <text>添加空间</text>
          </view>
        </view>

        <view class="space-rows" wx:if="{{node.children.length}}">
          <block wx:for="{{node.children}}" wx:key="id" wx:for-item="childNode">
            <view class="drag-line" wx:if="{{drag && drag.parentId === node.id && drag.index === index}}"></view>
            <space-node
              id="space-{{childNode.id}}"
              node="{{childNode}}"
              items-map="{{itemsMap}}"
              loading-map="{{loadingMap}}"
              drag="{{drag}}"
              highlight-id="{{highlightId}}"
              focus-id="{{focusId}}"
            />
          </block>
          <view class="drag-line" wx:if="{{drag && drag.parentId === node.id && drag.index >= node.children.length}}"></view>
        </view>
        <view class="mod-empty" wx:else>
          暂无子空间
        </view>
      </view>
    </view>
  </view>
</view>
