<view class="node {{node.depth === 0 ? 'node-root' : 'node-child'}}">
  <!-- ============ 根空间：一张白卡，卡内是整棵树的入口 ============ -->
  <view
    wx:if="{{node.depth === 0}}"
    class="sp-card is-root {{node.expanded ? 'is-open' : ''}} {{drag && drag.dragId === node.id ? 'is-dragging' : ''}}"
  >
    <view
      class="rc-head drag-measure"
      bindtap="onTap"
      bindlongpress="onDragStart"
      bindtouchmove="onDragMove"
      bindtouchend="onDragEnd"
      bindtouchcancel="onDragEnd"
    >
      <view class="rc-icon"><image class="rc-icon-img" src="{{node.cardIcon}}" mode="aspectFit" /></view>
      <view class="rc-meta">
        <text class="rc-name">{{node.name}}</text>
        <text class="rc-count">{{node.total ? '共 ' + node.total + ' 件物品' : '还没有物品'}}</text>
      </view>
      <view class="rc-act" catchtap="onMore" aria-label="管理空间">
        <image class="rc-act-icon" src="/assets/spaces/glyphs/more_horizontal.svg" mode="aspectFit" />
      </view>
      <view class="rc-toggle">
        <image class="rc-arrow" src="/assets/spaces/glyphs/chevron_down.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="rc-body is-root" wx:if="{{node.expanded}}" catchtap="noop">
      <!-- 空间：直属子空间列表；灰底只铺这一层容器，层级靠缩进与短竖线表达 -->
      <view class="sec-head">
        <view class="sec-ico"><image class="sec-ico-img" src="/assets/spaces/cards/other_space.svg" mode="aspectFit" /></view>
        <text class="sec-label">空间</text>
        <text class="sec-count">{{node.children.length}} 个</text>
        <view class="sec-add" catchtap="onAddSpace">
          <text class="sec-add-plus">＋</text>
          <text>添加空间</text>
        </view>
      </view>

      <view class="sp-list" wx:if="{{node.children.length}}">
        <block wx:for="{{node.children}}" wx:key="id" wx:for-item="childNode">
          <view
            class="drag-line"
            wx:if="{{drag && drag.parentId === node.id && drag.index === index}}"
          ></view>
          <space-node
            id="space-{{childNode.id}}"
            node="{{childNode}}"
            is-first="{{index === 0}}"
            items-map="{{itemsMap}}"
            loading-map="{{loadingMap}}"
            drag="{{drag}}"
            highlight-id="{{highlightId}}"
            focus-id="{{focusId}}"
          />
        </block>
        <view
          class="drag-line"
          wx:if="{{drag && drag.parentId === node.id && drag.index >= node.children.length}}"
        ></view>
      </view>
      <view class="mod-empty" wx:else>暂无子空间</view>

      <!-- 物品：直属物品，固定瓦片按可用宽度换行 -->
      <view class="sec-head sec-head-items">
        <view class="sec-ico"><image class="sec-ico-img" src="/assets/spaces/cards/other_space.svg" mode="aspectFit" /></view>
        <text class="sec-label">物品</text>
        <text class="sec-count">{{node.directCount}} 件</text>
        <view class="sec-add" catchtap="onAddItem">
          <text class="sec-add-plus">＋</text>
          <text>添加物品</text>
        </view>
      </view>

      <view class="mod-loading" wx:if="{{loadingMap[node.id]}}">
        <view class="mod-spinner"></view>
        <text class="mod-loading-text">正在读取物品…</text>
      </view>
      <view class="tiles" wx:elif="{{itemsMap[node.id] && itemsMap[node.id].length}}">
        <block wx:for="{{itemsMap[node.id]}}" wx:key="id">
          <view
            class="tile {{highlightId && highlightId === item.id ? 'is-highlight' : ''}}"
            wx:if="{{index < 8}}"
            id="item-{{item.id}}"
            catchtap="onTileTap"
            data-id="{{item.id}}"
          >
            <image class="tile-img" src="{{item.img}}" mode="aspectFill" />
            <text class="tile-name">{{item.name}}</text>
          </view>
        </block>
        <view class="tile" wx:if="{{itemsMap[node.id].length > 8}}" catchtap="onShowAll">
          <view class="tile-img tile-more"><text class="tile-more-txt">···</text></view>
          <text class="tile-name">查看全部</text>
        </view>
      </view>
      <view class="mod-empty" wx:else>此空间暂无直接存放的物品</view>
    </view>
  </view>

  <!-- ============ 子空间：一行 + 缩进一层的展开体 ============ -->
  <view
    wx:else
    class="tnode {{node.expanded ? 'open' : ''}} {{isFirst ? '' : 'has-sep'}}"
  >
    <view
      class="trow {{node.depth > 1 ? 'is-deep' : ''}} drag-measure"
      bindtap="onTap"
      bindlongpress="onDragStart"
      bindtouchmove="onDragMove"
      bindtouchend="onDragEnd"
      bindtouchcancel="onDragEnd"
    >
      <view class="t-ico"><image class="t-ico-img" src="{{node.cardIcon}}" mode="aspectFit" /></view>
      <text class="t-name {{node.expanded ? 'is-open' : ''}}">{{node.name}}</text>
      <text class="t-count {{node.total ? '' : 'zero'}}">{{node.total ? node.total + ' 件' : '空'}}</text>
      <view class="disclosure">
        <image class="t-arrow" src="/assets/spaces/glyphs/chevron_down.svg" mode="aspectFit" />
      </view>
    </view>

    <view class="tkids" wx:if="{{node.expanded}}" catchtap="noop">
      <view class="mod-loading" wx:if="{{loadingMap[node.id]}}">
        <view class="mod-spinner"></view>
        <text class="mod-loading-text">正在读取物品…</text>
      </view>
      <view class="tiles" wx:elif="{{itemsMap[node.id] && itemsMap[node.id].length}}">
        <block wx:for="{{itemsMap[node.id]}}" wx:key="id">
          <view
            class="tile {{highlightId && highlightId === item.id ? 'is-highlight' : ''}}"
            wx:if="{{index < 8}}"
            id="item-{{item.id}}"
            catchtap="onTileTap"
            data-id="{{item.id}}"
          >
            <image class="tile-img" src="{{item.img}}" mode="aspectFill" />
            <text class="tile-name">{{item.name}}</text>
          </view>
        </block>
        <view class="tile" wx:if="{{itemsMap[node.id].length > 8}}" catchtap="onShowAll">
          <view class="tile-img tile-more"><text class="tile-more-txt">···</text></view>
          <text class="tile-name">查看全部</text>
        </view>
      </view>

      <block wx:if="{{node.children.length}}">
        <block wx:for="{{node.children}}" wx:key="id" wx:for-item="childNode">
          <view
            class="drag-line"
            wx:if="{{drag && drag.parentId === node.id && drag.index === index}}"
          ></view>
          <space-node
            id="space-{{childNode.id}}"
            node="{{childNode}}"
            is-first="{{index === 0}}"
            items-map="{{itemsMap}}"
            loading-map="{{loadingMap}}"
            drag="{{drag}}"
            highlight-id="{{highlightId}}"
            focus-id="{{focusId}}"
          />
        </block>
        <view
          class="drag-line"
          wx:if="{{drag && drag.parentId === node.id && drag.index >= node.children.length}}"
        ></view>
      </block>

      <view
        class="mod-empty"
        wx:if="{{!loadingMap[node.id] && !(itemsMap[node.id] && itemsMap[node.id].length) && !node.children.length}}"
      >此空间暂无物品</view>

      <view class="child-actions">
        <text class="child-act" catchtap="onAddItem">＋ 添加物品</text>
        <text class="child-act" catchtap="onAddSpace">＋ 添加空间</text>
        <text class="child-act manage" catchtap="onMore">⋯ 管理</text>
      </view>
    </view>
  </view>
</view>
