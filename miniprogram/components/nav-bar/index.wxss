.nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.nav-back {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 用伪元素把返回键热区扩到约 88rpx 高（不吃布局、标题不位移）；
   右侧多出部分会盖住标题左侧空白区，当前标题无点击行为，勿在此区域加交互 */
.nav-back::after {
  content: '';
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  right: -32rpx;
  bottom: -16rpx;
}

.nav-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #124E5B;
  border-bottom: 4rpx solid #124E5B;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  margin-left: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #0F4C5A;
}
