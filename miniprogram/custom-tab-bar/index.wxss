/* 固定通栏底栏（对齐首页设计稿：白色全宽、贴底、上缘浅阴影） */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 内容区 100rpx + 底部留白（安全区优先，无安全区机型保底 24rpx，防止下移的文字贴边被裁） */
  height: calc(100rpx + max(24rpx, env(safe-area-inset-bottom)));
  background: #FFFFFF;
  display: flex;
  align-items: stretch;
  padding: 0 12rpx max(24rpx, env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -6rpx 24rpx rgba(4, 134, 157, 0.08);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  /* 图标与文字整体下移：图标盒顶距栏顶 22rpx，文字顺势探入底部留白区 */
  padding-top: 22rpx;
}

/* 选中态：仅图标与文字变色，无背景高亮 */

.tab-icon {
  width: 72rpx;
  height: 72rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.tab-label {
  margin-top: 0;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 1.3;
  color: #93A9AE;
}

.tab-label.on {
  color: #12A5A0;
}

