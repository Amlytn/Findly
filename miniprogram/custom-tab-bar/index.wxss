/* 固定通栏底栏：白色全宽、贴底、上缘浅阴影） */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 内容区适配微调，整体元素略向下移 */
  height: calc(108rpx + max(20rpx, env(safe-area-inset-bottom)));
  background: #FFFFFF;
  display: flex;
  align-items: stretch;
  padding: 0 12rpx calc(4rpx + max(20rpx, env(safe-area-inset-bottom)));
  box-sizing: border-box;
  box-shadow: 0 -6rpx 24rpx rgba(4, 134, 157, 0.08);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  /* 元素整体下移：从 20rpx 调整至 28rpx */
  padding-top: 28rpx;
}

/* 选中态：仅图标与文字变色，无背景高亮 */

.tab-icon {
  /* 图标归位无负边距，顺畅下移 */
  margin-top: 0;
  width: 38rpx;
  height: 38rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.tab-label {
  /* 文字微调：轻微再下移一点点点点 */
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 1.3;
  color: #93A9AE;
}

.tab-label.on {
  color: #12A5A0;
}

