# Maintainer: james-wu66
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，严禁提交到 GitHub。

# PostgreSQL 连接串（本地开发示例）
DATABASE_URL="postgresql://findly:findly@localhost:5432/findly"

# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com 开通后获取）
# 红线：此 key 绝不能写进任何会提交到 git 的文件，也绝不能放进小程序前端。
DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxx"

# 模型（可按需更换，后端做了抽象，换模型只改这里）
QWEN_VL_MODEL="qwen-vl-plus"
QWEN_TEXT_MODEL="qwen-turbo"

# 微信小程序登录（M4；公众平台 mp.weixin.qq.com → 开发管理 → 开发设置获取）
# 红线：AppSecret 绝不能写进任何会提交到 git 的文件或前端。
WX_APPID="wx0000000000000000"
WX_APPSECRET="your-app-secret-here"

# JWT 签名密钥（M4；上线前必须换强随机值）
JWT_SECRET="change-me-in-prod"

# 联调测试通道开关（1=可用 /auth/dev-token 签发测试 token；上线前删除此行）
AUTH_DEV_TOKEN="1"

# C17：孤儿图片清理接口（POST /upload/cleanup-orphans）的权限门。
# 该接口跨用户判断"图片是否还被引用"，误用会删全站图片，故默认关闭。
# 用法：CLEANUP_ORPHANS=1 才开；生产环境还必须把可信运维用户写进 CLEANUP_ADMINS（逗号分隔）。
# 开发环境只设 CLEANUP_ORPHANS=1 即可自查（不配名单）。
CLEANUP_ORPHANS="0"
CLEANUP_ADMINS=""

PORT=3000
