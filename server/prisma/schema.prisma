// Findly 数据库设计（方案文档第十三节六张表）
// 修改本文件后执行：npm run prisma:migrate 生成迁移（迁移文件必须一起提交）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  openid    String   @unique // 微信 openid（M4 接入微信登录后写入）
  nickname  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  Item[]
  spaces Space[]
  tags   Tag[]
}

model Space {
  id        String   @id @default(cuid())
  userId    String
  parentId  String? // 层级空间树（方案文档第十一节）
  name      String
  type      String? // home/room/furniture/container（前端图标选择器映射填写）
  icon      String? // 语义图标 key（如 kitchen/garage/basement；null 由前端按名称匹配兜底）
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  parent   Space?   @relation("SpaceTree", fields: [parentId], references: [id])
  children Space[]  @relation("SpaceTree")
  items    Item[]

  @@index([userId])
}

model Item {
  id           String    @id @default(cuid())
  userId       String
  name         String
  description  String?
  category     String?
  brand        String?
  model        String?
  color        String?
  status       String    @default("normal")
  quantity     Int       @default(1)
  spaceId      String?
  imageUrl     String?
  thumbnailUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // 软删除（方案文档第十二节）

  user      User       @relation(fields: [userId], references: [id])
  space     Space?     @relation(fields: [spaceId], references: [id])
  tags      ItemTag[]
  aiResults AIResult[]

  @@index([userId, spaceId])
  @@index([name])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user  User      @relation(fields: [userId], references: [id])
  items ItemTag[]

  @@unique([userId, name])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([itemId, tagId])
  // C04：主键 (itemId,tagId) 的最左列只能满足"某物品有哪些标签"；
  // items.related() 走的是反方向 tags.some.tagId in [...]，没有这个索引就全表扫。
  @@index([tagId])
}

model AIResult {
  id         String   @id @default(cuid())
  userId     String? // C09：调用归属。历史记录里只有能经 Item 反查出来的已回填，
                      // 其余为 null（识别后未保存成物品 → 无从判定归属），统计不计入但会如实报数。
  itemId     String? // 识别阶段暂无 itemId，物品保存后可回填
  taskType   String // recognize / parse-query
  resultJson String
  model      String
  createdAt  DateTime @default(now())

  item Item? @relation(fields: [itemId], references: [id])

  // C09/C08：统计接口固定按 userId 过滤、可带时间范围，故两列各建索引。
  // 详情页取"最近 5 次识别记录"走 itemId 外键，PG 不会为外键自动建索引，故一并补上。
  // taskType 不单独建索引——只有三个取值、基数极低，走索引比顺序扫还慢。
  @@index([userId])
  @@index([createdAt])
  @@index([itemId])
}
